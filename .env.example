PORT=3000
JWT_SECRET=replace-with-secure-secret-at-least-32-characters
JWT_ADMIN_SCOPE=routes:write
DEFAULT_UPSTREAM=http://localhost:4000
BRISKTROUTE_DB_PATH=.data/briskroute.sqlite
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_ALLOWED_HOSTS=localhost
UPSTREAM_ALLOWED_CIDRS=127.0.0.0/8,::1/128
TRUST_PROXY=false
